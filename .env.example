# 展示使用明细（调用详情）
REACT_APP_SHOW_DETAIL=true

# 展示余额（令牌信息）
REACT_APP_SHOW_BALANCE=true

# NewAPI 的 BaseURL（支持多个 NewAPI 站点聚合查询，键为站点名称，值为站点 URL）
REACT_APP_BASE_URL={"server1": "https://api.server1.com", "server2": "https://api.server2.com"}

# 是否显示 GitHub 图标
REACT_APP_SHOW_ICONGITHUB=true

# 站点标题（可选）
REACT_APP_TITLE=令牌用量查询

# 计费汇率：$1 = ? tokens（可选，默认 500000）
REACT_APP_QUOTA_PER_UNIT=500000
