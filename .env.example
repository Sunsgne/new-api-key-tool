# 展示使用明细（调用详情）
REACT_APP_SHOW_DETAIL=true

# 展示余额（令牌信息）
REACT_APP_SHOW_BALANCE=true

# 上游 NewAPI 站点地址（用于 nginx / 开发代理 反向代理到 /api，使前端与接口同源）
# 同源后才能调用 /api/log/self 等未开启 CORS 的接口，从而按时间范围拉取全量日志
REACT_APP_UPSTREAM=https://api.your-newapi.com

# 是否显示 GitHub 图标
REACT_APP_SHOW_ICONGITHUB=true

# 站点标题（可选）
REACT_APP_TITLE=令牌用量查询

# 计费汇率：$1 = ? tokens（可选，默认 500000）
REACT_APP_QUOTA_PER_UNIT=500000
